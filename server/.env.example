PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Firebase Admin SDK (service account JSON: project_id, client_email, private_key)
# Keep FIREBASE_PRIVATE_KEY on one line, in double quotes, with literal \n between lines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Alternative to the three variables above: path to the service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=

# Cloudinary signed uploads (Cloudinary dashboard > API Keys). The secret stays on the server only.
# Until these are set, the app falls back to the unsigned upload preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
