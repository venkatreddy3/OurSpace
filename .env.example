# Firebase web app config (Firebase Console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave unset (or false) to use real Firebase. "true" forces local mock mode.
# VITE_ENABLE_MOCK_AUTH=false

# Cloudinary image storage (unsigned upload preset; these two values are not secret)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
